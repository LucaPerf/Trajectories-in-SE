import django
from django.conf import settings
if not settings.configured:
    settings.configure(DEBUG=True)
django.setup()
from django.db import migrations, models
from django.db.migrations.optimizer import MigrationOptimizer

optimizer = MigrationOptimizer()

# Test case from the issue
operations = [
    migrations.AddField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=256, null=True),
    ),
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True),
    ),
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True, help_text='help'),
    ),
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True, help_text='help', default=None),
    ),
]

print('Test 1: AddField followed by multiple AlterFields (should optimize to single AddField):')
result = optimizer.optimize(operations, 'books')
print(f'  Input: {len(operations)} operations')
print(f'  Output: {len(result)} operations')
print(f'  Result: {result}')
print()

# Test case: multiple AlterFields without AddField
operations2 = [
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True),
    ),
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True, help_text='help'),
    ),
    migrations.AlterField(
        model_name='book',
        name='title',
        field=models.CharField(max_length=128, null=True, help_text='help', default=None),
    ),
]

print('Test 2: Multiple AlterFields (should reduce to single AlterField):')
result2 = optimizer.optimize(operations2, 'books')
print(f'  Input: {len(operations2)} operations')
print(f'  Output: {len(result2)} operations')
print(f'  Result: {result2}')
