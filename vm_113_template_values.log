        ):
            return [
                operation,
                AlterField(
                    model_name=self.model_name,
                    name=operation.new_name,
                    field=self.field,
                ),
            ]
        return super().reduce(operation, app_label)'''

content = content.replace(old_reduce, new_reduce)

with open('/testbed/django/db/migrations/operations/fields.py', 'w') as f:
