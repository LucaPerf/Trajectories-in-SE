def get_path():
    return "/some/path/"

# Test with callable
field = FilePathField(path=get_path)
print("Model field path (callable):", field.path)
assert field.path == "/some/path/", f"Expected '/some/path/', got '{field.path}'"

# Test with string
field2 = FilePathField(path="/another/path/")
